# Используем официальный легковесный и стабильный образ Python на базе Debian Bookworm
FROM python:3.12-slim

# Настройка переменных окружения Python для работы в контейнерах:
# PYTHONUNBUFFERED=1 — отключает буферизацию потоков вывода, логи сразу видны в docker logs
# PYTHONDONTWRITEBYTECODE=1 — запрещает Python писать файлы .pyc на диск (экономит место)
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Создаем безопасного непривилегированного системного пользователя для изоляции процессов приложения
RUN useradd --create-home python-user

# Устанавливаем изолированную рабочую директорию
WORKDIR /app

# Сначала копируем только файл зависимостей. Это позволяет Docker эффективно кэшировать слои PIP
COPY requirements.txt .

# Устанавливаем библиотеки без сохранения кэша загрузок на диске (минимизация размера образа)
RUN pip install --no-cache-dir -r requirements.txt

# Копируем исходный код бэкенда, сразу назначая владельцем нашего изолированного пользователя
COPY --chown=python-user:python-user app.py .

# Переключаем контекст выполнения на непривилегированного пользователя (защита хост-системы в случае взлома)
USER python-user

# Декларируем внутренний порт контейнера для документации
EXPOSE 5000

# Инструкция для запуска WSGI-сервера/приложения
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--access-logfile", "-", "--error-logfile", "-", "app:app"]